{
  "expo": {
    "name": "FlowX",
    "slug": "flowx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "flowx",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flowx.mobile",
      "infoPlist": {}
    },
    "android": {
      "package": "com.flowx.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "router": {
      "root": "src/app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "FlowX uses your photos so you can set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "494b8a9f-6668-4fd1-920a-861a4396bbe7"
      }
    }
  }
}
